# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=wafdb
MYSQL_USER=waf
MYSQL_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD

# WAF Application Configuration
LOG_LEVEL=INFO
WAF_LISTEN_HOST=0.0.0.0
WAF_LISTEN_PORT=8080

# Admin Panel Configuration
ADMIN_LISTEN_HOST=0.0.0.0
ADMIN_LISTEN_PORT=5000
ADMIN_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
WAF_RESET_URL=http://waf_app:8080/reset-db-management
